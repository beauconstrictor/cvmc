import std

const count = 8
var n: int

{:fact <n -- !n>
  (if-else (eq dup 0) {
    drop 1
  } {(if (gt dup 1) {
    (mul (fact (dec dup)))
  })})
}

{:main
  (puts "first 9 factorials: ")

  (while 0 {(not (eq dup COUNT))} {
    (puti (fact dup))
    (puts ", ")

    inc
  })

  (puts "\b\b \b")
}
