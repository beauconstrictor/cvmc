import std

{:calculate <buf -- res>
  (geti)
  (getc swap)
  (geti swap)
  (drop swap)
  swap

  (if (eq dup '+') {(add drop)})
  (if (eq dup '-') {(sub drop)})
  (if (eq dup '*') {(mul drop)})
  (if (eq dup '/') {(div drop)})
}

{:main
  var buf[256]: char

  (puts "calculator!") putl

  (while {true} {
    (gets buf (size buf))
    (putc '=') (puti (calculate buf)) putl
  })
}
