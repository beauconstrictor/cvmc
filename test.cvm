var a-global: 1

{:number-1
  var test: 2
  test

  {
    var another-test: 1
    another-test
    test
    a-global

    {
      var what: 1
      what
      another-test
      test
      a-global
    }

  }

  a-global
}

{:number-2
  var test: 3
  
  test
  a-global
}

{:main
  (puts "this is a scope testing program.\n")
}
