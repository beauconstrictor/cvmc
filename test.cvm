import std

var count: int
var pass: int
var fail: int

var group: str

{:test <assertion message -- > 
  swap

  (do {inc} count)

  (if-else {
    (puts "[PASS] ")
    (do {inc} pass)
  } {
    (puts "[FAIL] ")
    (do {inc} fail)
  })

  (puts (get group))
  (putc '/')
  puts
  putl
}

{:show-results
  putl
  (puts "Ran ")
  (puti (load count))
  (puts " tests.")
  putl

  (if-else (eq (get fail) 0) {
    (puts "All tests passed.") putl
  } {
    (puts "Passed: ") 
    (puti (load pass))
    (puts " / ")
    (puti (load count))
    putl
  })
}

{:test-isspace
  (put "isspace" group)

  (test (isspace ' ')  "space")
  (test (isspace '\t') "tab")
  (test (isspace '\n') "newline")
  (test (isspace '\v') "vertical tab")
  (test (isspace '\f') "form feed")
  (test (isspace '\r') "carriage return")

  (test (not (isspace 'a'))  "letter")
  (test (not (isspace '0'))  "digit")
  (test (not (isspace '\0')) "nul")
  (test (not (isspace 127))  "del")
  (test (not (isspace 255))  "maximum byte")
}

{:main
  (put 0 count)
  (put 0 pass)
  (put 0 fail)

  test-isspace

  show-results
}
