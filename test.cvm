import std

var buf[256]: char
var stack[16]: int
var stack.top: ptr

{:push <val -- >
  (set (get stack.top) swap)
  (set stack.top (add (get stack.top) int))
}

{:pop < -- val>
  (set stack.top (sub (get stack.top) int))
  (get (get stack.top))
}

{:execute-token <buf -- res>
  (geti dup)
  rot rot

  (over swap)
  
  (if-else (eq over) {
    drop
    (load dup)
    (drop rot)
    (if (eq dup '+') {(push (add pop pop))})
    (if (eq dup '-') {(push (sub pop pop swap))})
    (if (eq dup '*') {(push (mul pop pop))})
    (if (eq dup '/') {(push (div pop pop swap))})
    (if (eq dup '%') {(push (mod pop pop swap))})
    (if-else (eq '\0') {drop 0} &inc)
  } {
    (push rot)
    drop
  })
}

{:main
  (set stack.top stack)

  (while {true} {
    (gets buf (size buf))

    buf (do-while {
      (dup (execute-token))
    })

    (if-else (eq (get errno) errno-success) {
      (putc '=') (puti pop) putl
    } {
      (puts "error") putl
    })
  })
}
