const true = 1
const false = 0

const char = 1
const byte = 1
const bool = 1

const int = 2
const uint = 2

{:if <condition true -- > (if-else {})}
{:do-while <body condition -- > swap dup i while}

{:bool-of <a -- NOT a> (if-else {true} {false})}
{:not <a -- NOT a> (if-else {false} {true})}
{:and <a b -- a AND b> (if-else {if-else {true} {false}} {false})}
{:nand <a b -- a NAND b> (not and)}
{:or <a b -- a OR b> (if-else {true} {if-else {true} {false}})}
{:nor <a b -- a NOR b> (not or)}

{:lt <a b -- a lt b> (gt swap)}
{:le <a b -- a le b> (not gt)}
{:ge <a b -- a ge b> (not lt)}
{:ne <a b -- a != b> (not eq)}

{:puts <s -- >
  (while {(load dup)} {
    (putc (load dup))
    inc
  })
  drop
}

{:putl <s -- > puts (putc 10)}

{:dec <n -- n-1> (sub 1)}
{:inc <n -- n+1> (add 1)}

{:mul <a b -- a*b>
  (swap 0)

  (while {dup} {
    rot
    rot
    swap
    dup
    rot
    add
    rot
    dec
  })
  
  drop
  swap
  drop
}

