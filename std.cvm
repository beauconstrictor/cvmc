const true = 1
const false = 0

const i8 = 1
const u8 = 1
const char = 1
const byte = 1
const bool = 1

const i16 = 2
const u16 = 2
const int = 2
const uint = 2
const ptr = 2
const callable = 2
const str = 2

<some std functions do not have a signature. in this case, this
 function is 'internal', and should not be used.>

<some functions set errno instead of returning normally. in this
 case, their actual return values may not make any sense, but they
 will always have the same net stack effect no matter what.

 if a function sets errno, this will be documented in the signature.

 to check if a function returned an error, (clear errno) beforehand,
 and check (ne (get errno) errno_succ)>

const errno_succ = 0
const errno_0div = 1

var errno: int

{:if <condition true -- > (if-else {})}
{:do-while <body condition -- > swap dup call while}

{:bool-of <a -- NOT NOT a> (if-else {true} {false})}
{:not <a -- NOT a> (if-else {false} {true})}
{:and <a b -- a AND b> (if-else {(if-else {true} {false})} {drop false})}
{:nand <a b -- a NAND b> (not and)}
{:or <a b -- a OR b> (if-else {true} {if-else {true} {false}})}
{:nor <a b -- a NOR b> (not or)}

{:eq <a b -- a == b> sub (if-else {false} {true})}
{:ne <a b -- a != b> sub (if-else {true} {false})}
{:lt <a b -- a lt b> (gt swap)}
{:le <a b -- a le b> (not gt)}
{:ge <a b -- a ge b> (not lt)}

{:at <arr size idx -- ptr> (add mul)}
{:clear <ptr -- > (set 0)}

{:puts <s -- >
  (while {(load dup)} {
    (putc (load dup))
    inc
  })
  drop
}

{:puti <n -- >
  (if (lt dup 0) {
    (putc '-')
  })
  abs
  (if (gt dup 9) {
    (puti (div dup 10))
  })
  (putc (add (mod 10) '0'))
}

{:putb <s -- > (if-else {(puts "true")} {(puts "false")})}
{:putl <s -- > (putc '\n')}

{:over <a b -- a b a> swap dup rot swap}

{:dec <n -- n-1> (sub 1)}
{:inc <n -- n+1> (add 1)}

{:neg <n -- -n> (sub (swap 0))}
{:abs <n -- |n|> (if (lt dup 0) {neg})}
{:sgn <n -- n'> 
  (if (ne dup 0) {
    (if-else (gt 0) {
      1
    } {
      -1
    })
  })
}
{:set-sgn <a b -- a'>
  (if-else (eq dup 0) {
    drop drop 0
  } {
    (if-else (gt 0) {
      abs
    } {
      (neg abs)
    })
  })
}


<somehow, this actually DOES work with signed values, despite no
 specific handling for them>
{:mul <a b -- a*b>
  (swap 0)

  (while {dup} {
    rot rot
    swap dup rot add
    rot dec
  })
  
  drop swap drop
}

<does not correctly handle negatives>
{:raw-div-mod <a b -- a/b a%b>
  (rot (rot 0))

  (while {(ge over over)} {
    over over
    sub
    rot
    drop swap rot inc
    rot rot
  })

  drop
}

{:div-mod
  (if-else (eq dup 0) {
    (set errno errno_0div)
  } {
    (sgn over)
    (sgn over)
    (if-else (eq) {1} {-1})
    (abs rot)
    (abs rot)
    raw-div-mod
    (swap (set-sgn rot rot swap))
    })

}

{:div <a b -- a/b> <sets errno> (drop div-mod)}
{:mod <a b -- a%b> <sets errno> (drop (swap div-mod))}
