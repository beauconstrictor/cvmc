const true = 1
const false = 0

const char = 1
const byte = 1
const bool = 1

const int = 2
const uint = 2

{:if <condition true -- > (if-else {})}
{:do-while <body condition -- > swap dup i while}

{:bool-of <a -- NOT NOT a> (if-else {true} {false})}
{:not <a -- NOT a> (if-else {false} {true})}
{:and <a b -- a AND b> (if-else {(if-else {true} {false})} {drop false})}
{:nand <a b -- a NAND b> (not and)}
{:or <a b -- a OR b> (if-else {true} {if-else {true} {false}})}
{:nor <a b -- a NOR b> (not or)}

{:eq <a b -- a == b> sub (if-else {false} {true})}
{:ne <a b -- a != b> sub (if-else {true} {false})}
{:lt <a b -- a lt b> (gt swap)}
{:le <a b -- a le b> (not gt)}
{:ge <a b -- a ge b> (not lt)}

{:puts <s -- >
  (while {(load dup)} {
    (putc (load dup))
    inc
  })
  drop
}
{:putb <s -- > (if-else {(puts "true")} {(puts "false")})}

{:putl <s -- > (putc '\n')}

{:over <a b -- a b a> swap dup rot swap}

{:dec <n -- n-1> (sub 1)}
{:inc <n -- n+1> (add 1)}

{:neg <n -- -n> (sub (swap 0))}
{:abs <n -- |n|> (if (lt dup 0) {neg})}
{:sgn <n -- n'> 
  (if (ne dup 0) {(if-else (gt 0) {
    1
  } {
    -1
  })})
}

{:mul <a b -- a*b>
  (swap 0)

  (while {dup} {
    rot rot
    swap dup rot add
    rot dec
  })
  
  drop swap drop
}

<does not correctly handle negatives>
{:raw-div-mod <a b -- a/b a%b>
  (rot (rot 0))

  (while {(ge over over)} {
    over over
    sub
    rot
    drop swap rot inc
    rot rot
  })

  drop
}

<corrects the signs before and after passing to raw-div-mod>
{:div-mod
  abs
  (abs over)
  swap
  raw-div-mod
}

{:div <a b -- a/b> (drop div-mod)}
{:mod <a b -- a%b> (drop (swap div-mod))}
