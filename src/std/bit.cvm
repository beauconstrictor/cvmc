require std

{:shl* <n count -- n shl count> (mul (pow 2 swap))}
{:shr* <n count -- n shr count> (udiv (pow 2 swap))}

{:__bitwise <a b op -- n>
  var op: callable
  var a: int
  var b: int

  (put op)
  (put b)
  (put a)

  var acc: int
  var weight: int
  var i: int

  (put 0 acc)
  (put 1 weight)
  (put 0 i)

  (while {(lt (get i) 16)} {
    (if (mod (get a) 2)
        (mod (get b) 2)
        (call (get op)) {
      (do {(add (get weight))} acc)
    })

    (do {(add dup)} weight)
    (do {(shr 1)} a)
    (do {(shr 1)} b)
    (do {inc} i)
  })

  (get acc)
}

{:b-not <n -- ~n> (sub neg 1)}
{:b-and* <a b -- a b-and b>   (__bitwise {and})}
{:b-nand* <a b -- a b-nand b> (__bitwise {nand})}
{:b-or* <a b -- a b-or b>     (__bitwise {or})}
{:b-nor* <a b -- a b-nor b>   (__bitwise {nor})}
{:b-xor* <a b -- a b-xor b>   (__bitwise {xor})}

