require std

{:shl* <n count -- n shl count> (mul (pow 2 swap))}
{:shr* <n count -- n shr count> (udiv (pow 2 swap))}

{:bitwise <a b op -- n>
  var op: callable
  var a: int
  var b: int

  (put op)
  (put b)
  (put a)

  var acc: int
  var weight: int
  var i: int

  (put 0 acc)
  (put 1 weight)
  (put 0 i)

  (while {(lt (get i) 16)} {
    (if (mod (get a) 2)
        (mod (get b) 2)
        (call (get op)) {
      (do {(add (get weight))} acc)
    })

    (do {(add dup)} weight)
    (do {(shr 1)} a)
    (do {(shr 1)} b)
    (do {inc} i)
  })

  (get acc)
}

{:b-not <n -- ~n> (sub neg 1)}
{:b-and* <a b -- a b-and b> (bitwise {and})}
{:b-nand* <a b -- a b-nand b> (bitwise {nand})}
{:b-or* <a b -- a b-or b> (bitwise {or})}
{:b-nor* <a b -- a b-nor b> (bitwise {nor})}
{:b-xor* <a b -- a b-xor b> (bitwise {xor})}

{:isdigit* <c -- c'> (and (ge dup '0') (le over '9')) nip}
{:islower* <c -- c'> (and (ge dup 'a') (le over 'z')) nip}
{:isupper* <c -- c'> (and (ge dup 'A') (le over 'Z')) nip}
{:isalpha* <c -- c'> (or (islower dup) (isupper over)) nip}
{:isalnum* <c -- c'> (or (isalpha dup) (isdigit over)) nip}
{:isspace* <c -- c'> 
  false
  (if (not dup) {drop (eq dup ' ')})
  (if (not dup) {drop (eq dup '\t')})
  (if (not dup) {drop (eq dup '\n')})
  (if (not dup) {drop (eq dup '\v')})
  (if (not dup) {drop (eq dup '\f')})
  (if (not dup) {drop (eq dup '\r')})
  nip
}
