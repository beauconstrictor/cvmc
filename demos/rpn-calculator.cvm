import std

const x-errno-stack = 32768

var buf[256]: char
var stack[16]: int
var stack.top: ptr

{:init-stack < -- > (put stack stack.top)}

{:add* break}

{:push <val -- >
  (if-else (eq (get stack.top) (add stack (size stack))) {
    (put x-errno-stack errno)
    drop
  } {
    (put (get stack.top))
    (put (add (get stack.top) int) stack.top)
  })
}

{:pop < -- val>
  (if-else (eq (get stack.top) stack) {
    (put x-errno-stack errno)
    -1
  } {
    (put (sub (get stack.top) int) stack.top)
    (get (get stack.top))
  })
}

{:execute-token <token -- end>
  (geti dup)
  rot rot

  (over swap)
  
  (if-else (eq over) {
    drop
    (load dup)
    (drop rot)
    (if (eq dup 0x2b) {(push (add pop pop))})
    (if (eq dup '-') {(push (sub pop pop swap))})
    (if (eq dup '*') {(push (mul pop pop))})
    (if (eq dup '^') {(push (pow pop pop swap))})
    (if (eq dup '/') {(push (div pop pop swap))})
    (if (eq dup '%') {(push (mod pop pop swap))})
    (if-else (eq '\0') {drop 0} {inc})
  } {
    (push rot)
    drop
  })
}

{:evaluate <buf -- >
  (clear errno)

  (do-while {
    (dup (execute-token))
  })

  (if-else (eq (get errno) errno-success) {
    pop
    init-stack
    (push dup)
    (putc '=') (puti) putl
  } {
    (puts "error") putl
  })
}

{:main
  init-stack

  (puts "rpn calculator") putl

  (while {true} {
    (gets buf (size buf))
    (evaluate buf)
  })
}
