import std

-- this is a pattern for multiline string literals; the inc skips the
-- leading newline.
{:help (inc "
this calculator uses RPN, so operands come before operators.

supported operations:
- '+': add
- '-': subtract
- '*': multiply
- '^': exponentiate
- '/': divide
- '%': modulo
- '<': shift left
- '>': shift right
- '&': bitwise and
- '|': bitwise or
- 'x': bitwise xor
- '~': bitwise not (only takes a single operand)

for the bitwise operators, it is worth knowing that this calculator
represents numbers as signed 16-bit values, with two's complement.
")}

{:prompt "> "}

enum errno: (x-stack)

var buf[256]: char
var stack[16]: int
var stack.top: ptr

{:init-stack < -- > (put stack stack.top)}

{:push <val -- > <sets errno>
  (if-else (eq (get stack.top) (add stack (size stack))) {
    (put errno.x-stack errno)
    drop
  } {
    (put (get stack.top))
    (put (add (get stack.top) int) stack.top)
  })
}

{:pop < -- val> <sets errno>
  (if-else (eq (get stack.top) stack) {
    (put errno.x-stack errno)
    -1
  } {
    (put (sub (get stack.top) int) stack.top)
    (get (get stack.top))
  })
}

{:execute-token <token -- end> <sets errno>
  (geti dup)
  rot rot
  tuck
  
  (if-else (eq over) {
    drop
    (load dup)
    (drop rot)
    (if (eq dup '+') {(push (add pop pop swap))})
    (if (eq dup '-') {(push (sub pop pop swap))})
    (if (eq dup '*') {(push (mul pop pop swap))})
    (if (eq dup '^') {(push (pow pop pop swap))})
    (if (eq dup '/') {(push (div pop pop swap))})
    (if (eq dup '%') {(push (mod pop pop swap))})
    (if (eq dup '<') {(push (shl pop pop swap))})
    (if (eq dup '>') {(push (shr pop pop swap))})
    (if (eq dup '&') {(push (b-and pop pop swap))})
    (if (eq dup '|') {(push (b-or pop pop swap))})
    (if (eq dup 'x') {(push (b-xor pop pop swap))})

    (if (eq dup '~') {(push (b-not pop))})

    (if-else (eq '\0') {drop 0} {inc})
  } {
    (push rot)
    drop
  })
}

{:evaluate <buf -- > <sets errno>
  (clear-errno)

  (do-while {
    (dup (execute-token))
  })

  (if-else (check-errno) {
    (puts "error") putl
  } {
    pop
    init-stack
    (push dup)
    (putc '=') puti putl
  })
}

{:main
  init-stack

  (puts "cvmc/demos - RPN Calculator") putl
  (puts "Type 'help' for help.") putl
  putl

  (while {true} {
    (puts prompt)
    (gets buf (size buf))
    (if-else (scmp buf "help") {
      (puts help)
    } {
      (evaluate buf)
    })
  })
}
